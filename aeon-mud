#!/usr/bin/env sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$script_dir/aeon_mud_client.py" ]; then
  client="$script_dir/aeon_mud_client.py"
elif [ -f "$HOME/.local/share/aeon-mud/aeon_mud_client.py" ]; then
  client="$HOME/.local/share/aeon-mud/aeon_mud_client.py"
else
  printf '%s\n' "Cannot find aeon_mud_client.py" >&2
  exit 1
fi
exec python3 "$client" "$@"
